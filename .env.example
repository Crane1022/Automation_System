# ---------- Public URL ----------
DOMAIN=automation.widebed.com
PUBLIC_BASE_URL=https://automation.widebed.com
CORS_ORIGINS=https://automation.widebed.com

# ---------- Firebase (server) ----------
FIREBASE_PROJECT_ID=your-firebase-project-id
# The service-account JSON is mounted as a Docker secret from ./secrets/firebase-service-account.json.
# Alternative for platforms without file secrets:
# FIREBASE_SERVICE_ACCOUNT_BASE64=

# ---------- Firebase (web app build, public identifiers) ----------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_APP_ID=

# ---------- Security ----------
# 32 random bytes, base64:  openssl rand -base64 32
ENCRYPTION_KEY=
# These emails become Super Admin on first sign-in. Everyone else starts as "pending".
SUPER_ADMIN_EMAILS=it@widebed.com

# ---------- Queue (Phase 2) ----------
# docker-compose builds REDIS_URL from this password. For local development without Docker,
# set REDIS_URL=redis://localhost:6379 in apps/api/.env (or leave it empty to run everything in one process).
REDIS_PASSWORD=change-me-to-a-long-random-string

# ---------- Gmail (Google OAuth client) ----------
# Google Cloud console → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorised redirect URI:  https://automation.widebed.com/oauth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ---------- Execution limits ----------
# AI Staff background tasks: how many at once per worker, and the longest one may take (ms)
AI_TASK_CONCURRENCY=3
AI_TASK_TIMEOUT_MS=600000
EXECUTION_CONCURRENCY=5
EXECUTION_TIMEOUT_MS=300000
EXECUTION_RETENTION_DAYS=30
MAX_QUEUE_LENGTH=1000
# Longest Wait node pause (ms) and Code node memory (MB)
WAIT_MAX_MS=3600000

# Widebed Assistant
# ASSISTANT_BROWSER=true                 # false = never use the web browser
# ASSISTANT_FILES_DIR=/app/assistant-files  # downloaded bills etc. (kept 7 days); default: system temp folder
CODE_MAX_MEMORY_MB=128

# ---------- HTTP Request node (SSRF protection) ----------
# Keep false in production. To let workflows call internal systems (e.g. PMS on the LAN),
# list their hostnames instead:
HTTP_ALLOW_PRIVATE_NETWORKS=false
HTTP_ALLOWED_PRIVATE_HOSTS=
HTTP_MAX_RESPONSE_BYTES=5242880

# ---------- Rate limits ----------
RATE_LIMIT_PER_MINUTE=300
WEBHOOK_RATE_LIMIT_PER_MINUTE=120
WEBHOOK_MAX_BODY_BYTES=1048576
# Vercel without Redis: keep webhook calls open until the run ends (e.g. an AI Chatbot reply). 0 = answer at once.
WEBHOOK_WAIT_SECONDS=25
