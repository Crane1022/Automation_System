From 71135e36aa2417fd3dca057d89f3fd328e99d2c2 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 19 Nov 2026 09:38:55 +0800
Subject: [PATCH] Vercel: rename src/server.ts to src/main.ts so Vercel uses
 index.cjs

Vercel ignores the configured entrypoint and auto-detects src/app.* / src/server.*,
compiling them as CommonJS. With neither present, apps/api/index.cjs is the only entry.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Way2MS1H6pPjhw4J1S9nj4
---
 apps/api/package.json               | 6 +++---
 apps/api/src/bootstrap.ts           | 2 +-
 apps/api/src/{server.ts => main.ts} | 0
 apps/api/src/vercel.ts              | 2 +-
 docker/api-browser.Dockerfile       | 2 +-
 docker/api.Dockerfile               | 2 +-
 6 files changed, 7 insertions(+), 7 deletions(-)
 rename apps/api/src/{server.ts => main.ts} (100%)

diff --git a/apps/api/package.json b/apps/api/package.json
index cac2f58..ad74af0 100644
--- a/apps/api/package.json
+++ b/apps/api/package.json
@@ -3,11 +3,11 @@
   "version": "0.1.0",
   "private": true,
   "type": "module",
-  "main": "dist/server.js",
+  "main": "dist/main.js",
   "scripts": {
-    "dev": "tsx watch src/server.ts",
+    "dev": "tsx watch src/main.ts",
     "build": "tsc -p tsconfig.json",
-    "start": "node dist/server.js",
+    "start": "node dist/main.js",
     "dev:worker": "tsx watch src/worker.ts",
     "start:worker": "node dist/worker.js",
     "build:vercel": "tsc -p tsconfig.json && esbuild dist/vercel.js --bundle --platform=node --target=node22 --format=cjs --outfile=vercel/index.js --external:bullmq --external:cors --external:cron-parser --external:express --external:firebase-admin --external:ioredis --external:zod --footer:js=\"module.exports = Object.assign(module.exports.default, { default: module.exports.default });\" --log-level=warning"
diff --git a/apps/api/src/bootstrap.ts b/apps/api/src/bootstrap.ts
index 8d78d46..5453f5f 100644
--- a/apps/api/src/bootstrap.ts
+++ b/apps/api/src/bootstrap.ts
@@ -33,7 +33,7 @@ export interface BuildOptions {
 }
 
 /**
- * Wires all services together. Used by server.ts, worker.ts and the tests.
+ * Wires all services together. Used by main.ts, worker.ts and the tests.
  * With REDIS_URL: BullMQ queue + scheduler + Redis pub/sub.
  * Without: everything in this process (development / tests).
  */
diff --git a/apps/api/src/server.ts b/apps/api/src/main.ts
similarity index 100%
rename from apps/api/src/server.ts
rename to apps/api/src/main.ts
diff --git a/apps/api/src/vercel.ts b/apps/api/src/vercel.ts
index 16e73aa..150d427 100644
--- a/apps/api/src/vercel.ts
+++ b/apps/api/src/vercel.ts
@@ -10,7 +10,7 @@ import { createApp } from './create-app.js';
  * Entry point for Vercel (see vercel.json → services.api).
  *
  * Vercel runs the API as functions: it imports this file and sends requests to the exported
- * Express app. There is no app.listen() and no long-lived process, so compared with server.ts:
+ * Express app. There is no app.listen() and no long-lived process, so compared with main.ts:
  *   - Environment variables come from the Vercel project settings (no .env file).
  *   - Firebase credentials must be in FIREBASE_SERVICE_ACCOUNT_BASE64 (there is no secret file).
  *   - The "interrupted execution" clean-up on startup is skipped: Vercel starts new copies of the
diff --git a/docker/api-browser.Dockerfile b/docker/api-browser.Dockerfile
index 7ef6d33..8216ca5 100644
--- a/docker/api-browser.Dockerfile
+++ b/docker/api-browser.Dockerfile
@@ -38,4 +38,4 @@ RUN npx playwright install --with-deps chromium && mkdir -p /app/assistant-files
 USER node
 EXPOSE 4000
 HEALTHCHECK --interval=30s --timeout=5s --start-period=20s CMD node -e "fetch('http://127.0.0.1:4000/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
-CMD ["node", "apps/api/dist/server.js"]
+CMD ["node", "apps/api/dist/main.js"]
diff --git a/docker/api.Dockerfile b/docker/api.Dockerfile
index f11bfdc..fd4f8fd 100644
--- a/docker/api.Dockerfile
+++ b/docker/api.Dockerfile
@@ -31,4 +31,4 @@ COPY --from=build /app/apps/api/dist apps/api/dist
 USER node
 EXPOSE 4000
 HEALTHCHECK --interval=30s --timeout=5s --start-period=20s CMD wget -qO- http://127.0.0.1:4000/healthz || exit 1
-CMD ["node", "apps/api/dist/server.js"]
+CMD ["node", "apps/api/dist/main.js"]
-- 
2.43.0

