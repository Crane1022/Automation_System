{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "apps/api",
      "framework": "express",
      "installCommand": "cd ../.. && PUPPETEER_SKIP_DOWNLOAD=1 npm ci --no-audit --no-fund",
      "buildCommand": "cd ../.. && npm run build:packages && npm run build -w apps/api",
      "entrypoint": "dist/vercel.js"
    },
    "web": {
      "root": "apps/web",
      "framework": "vite",
      "installCommand": "cd ../.. && PUPPETEER_SKIP_DOWNLOAD=1 npm ci --no-audit --no-fund",
      "buildCommand": "cd ../.. && npm run build:packages && npm run build -w apps/web",
      "outputDirectory": "dist",
      "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/hooks/(.*)", "destination": { "service": "api" } },
    { "source": "/events/(.*)", "destination": { "service": "api" } },
    { "source": "/oauth/(.*)", "destination": { "service": "api" } },
    { "source": "/healthz", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
